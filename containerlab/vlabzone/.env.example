# Per-host settings for the vLabZone test environment.
# Copy to .env (Ansible renders it automatically) and adjust.

# Edge implementation: linux | routeros
EDGE_IMPL=linux
# Edge mode: vrf | pbr
EDGE_MODE=vrf
# Resource profile checked by the preflight: base | scale
VLAB_PROFILE=base
# Build the RouterOS CHR image on this host (needs /dev/kvm): true | false
VLAB_ROUTEROS_ENABLED=false
# Match the RouterOS version of the real MikroTik; other versions need ROUTEROS_SHA256
ROUTEROS_VERSION=7.24.6
# sha256 of chr-<version>.vmdk.zip (empty = built-in value for 7.24.6)
ROUTEROS_SHA256=

# Optional build settings for restricted networks
APT_MIRROR=
HTTP_PROXY=
HTTPS_PROXY=
