#!/usr/bin/env bash
# sw-port <port> <vlan|none> – make <port> an untagged access port in <vlan>, or
# take it out of every VLAN ("none": the device is ungrouped and cut off).
# Removes all other VLANs from the port. Called at start and by the broker (stage 3) –
# the equivalent of the later automation of the real (Lancom) system switches.
set -euo pipefail
port=${1:?usage: sw-port <port> <vlan|none>}
vlan=${2:?usage: sw-port <port> <vlan|none>}
if [[ "$vlan" != none ]]; then
  [[ "$vlan" =~ ^[0-9]+$ ]] && (( vlan >= 1 && vlan <= 4094 )) || { echo "invalid VLAN $vlan" >&2; exit 2; }
fi
[[ -e /sys/class/net/$port ]] || { echo "no such port $port" >&2; exit 2; }

for vid in $(bridge -j vlan show dev "$port" | jq -r '.[].vlans[]?.vlan'); do
  bridge vlan del dev "$port" vid "$vid"
done
if [[ "$vlan" == none ]]; then
  echo "$port -> no VLAN"
else
  bridge vlan add dev "$port" vid "$vlan" pvid untagged
  echo "$port -> VLAN $vlan"
fi
