#!/usr/bin/env python3
"""Query config/setups.yaml (mounted at /etc/vlab) from shell scripts.

  vlab-cfg setups                 -> "<id> <vlan> <net> <gateway>" per setup
  vlab-cfg ports                  -> "<port> <vlan> <node>" per lab-sw access port
                                     (devices; plus the gw-N ports if EDGE_MODE=pbr)
  vlab-cfg trunk-vlans            -> VLANs on the trunk to the edge (depends on EDGE_MODE)
  vlab-cfg gw-ip <id>             -> transfer address of gw-<id> (PBR mode)
  vlab-cfg get edge.wg_port_base  -> scalar value
  vlab-cfg setup <id> <key>       -> value of one setup field
"""
import ipaddress
import os
import sys

import yaml

CFG = os.path.join(os.environ.get("VLAB_CONFIG_DIR", "/etc/vlab"), "setups.yaml")
MODE = os.environ.get("EDGE_MODE", "vrf")


def setup(cfg, sid):
    return next(s for s in cfg["setups"] if s["id"] == int(sid))


def main(argv):
    with open(CFG) as fh:
        cfg = yaml.safe_load(fh)
    cmd = argv[1] if len(argv) > 1 else "setups"
    transfer = cfg["edge"]["transfer"]
    if cmd == "setups":
        for s in cfg["setups"]:
            print(s["id"], s["vlan"], s["net"], s["gateway"])
    elif cmd == "ports":
        for s in cfg["setups"]:
            for d in s.get("devices", []):
                print(d["port"], s["vlan"], d["name"])
            if MODE == "pbr":
                gw = s["pbr_gateway"]
                print(gw["setup_port"], s["vlan"], f"gw-{s['id']}")
                print(gw["transfer_port"], transfer["vlan"], f"gw-{s['id']}")
    elif cmd == "trunk-vlans":
        # VRF: the edge itself sits in every setup VLAN. PBR: the edge only talks to the gateways.
        vlans = [s["vlan"] for s in cfg["setups"]] if MODE == "vrf" else [transfer["vlan"]]
        print(*vlans)
    elif cmd == "gw-ip":
        print(ipaddress.ip_network(transfer["net"]).network_address + int(argv[2]))
    elif cmd == "get":
        val = cfg
        for part in argv[2].split("."):
            val = val[part]
        print(val)
    elif cmd == "setup":
        print(setup(cfg, argv[2])[argv[3]])
    else:
        sys.exit(f"unknown command {cmd}")


if __name__ == "__main__":
    main(sys.argv)
